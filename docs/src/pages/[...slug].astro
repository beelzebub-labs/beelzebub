---
import { render, type CollectionEntry } from 'astro:content';
import { Docs } from '@/components/docs';
import defaultMdxComponents from 'fumadocs-ui/mdx';
import '@/styles/global.css';
import { getPageImageUrl, source } from '@/lib/source';
import Layout from '@/components/layout.astro';
import type { TOCItemType } from 'fumadocs-core/toc';
import RuntimeArchitecture from '@/components/runtime-architecture.astro';
import BinaryTcpFlow from '@/components/binary-tcp-flow.astro';
import BeyondRuntime from '@/components/beyond-runtime.astro';
import { ExampleCode } from '@/components/example-code';

interface Props { page: CollectionEntry<'docs'>; }

export function getStaticPaths() {
  return source.getPages().map((page) => ({
    params: { slug: page.slugs.length > 0 ? page.slugs.join('/') : undefined },
    props: { page: page.data._raw },
  }));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const slugs = typeof Astro.params.slug === 'string' ? Astro.params.slug.split('/') : [];
const docsPage = source.getPage(slugs)!;
const toc: TOCItemType[] = headings.map((heading) => ({ depth: heading.depth, title: heading.text, url: `#${heading.slug}` }));
const site = Astro.site ?? Astro.url;
const image = new URL(getPageImageUrl(docsPage), site).href;
const canonical = new URL(Astro.url.pathname, site).href;
const title = `${page.data.title} | Beelzebub`;
---
<Layout title={title} description={page.data.description} image={image} canonical={canonical}>
  <Docs
    tree={source.getPageTree()}
    pathname={Astro.url.pathname}
    params={Astro.params}
    page={{
      toc,
      editOnGithub: {
        owner: 'beelzebub-labs',
        repo: 'beelzebub',
        sha: 'main',
        path: `docs/content/docs/${page.id}.mdx`,
      },
    }}
    client:load
  >
    <h1 class="font-semibold text-3xl">{page.data.title}</h1>
    <p class="text-lg text-fd-muted-foreground mb-8">{page.data.description}</p>
    <div class="prose flex-1"><Content components={{ ...defaultMdxComponents, RuntimeArchitecture, BinaryTcpFlow, BeyondRuntime, ExampleCode }} /></div>
  </Docs>
</Layout>
